# REQUIRED on Railway: generate a long random string (e.g. `openssl rand -base64 48`).
# Placeholder values crash startup when using core.settings.prod (DEBUG is False).
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# ALLOWED_HOSTS, CORS origins, and FRONTEND_URL are hardcoded in core/settings/{dev,prod}.py.
# Production (Railway): leave unset locally to keep SQLite. Postgres when set.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
RESEND_API_KEY=
# From address must be on a domain verified in Resend. RESEND_FROM_EMAIL is an alias.
EMAIL_FROM=Lundrii <noreply@lundrii.app>
# RESEND_FROM_EMAIL=notifications@your-verified-domain.com
# Cache backend — Django built-ins only, no Redis.
#   locmem : in-process, single worker only (default in dev)
#   db     : Django DatabaseCache, shared across workers (default in prod)
#   dummy  : no caching (OTP login will not work)
CACHE_BACKEND=locmem
# Background tasks — Django's Tasks framework (django.tasks), no Celery.
# ImmediateBackend runs enqueued tasks inline; DummyBackend records without running.
TASKS_BACKEND=django.tasks.backends.immediate.ImmediateBackend
OTP_TTL_SECONDS=600
OTP_VERIFY_TTL_SECONDS=1800
OTP_RESET_TTL_SECONDS=3600
VERIFY_LINK_TTL_SECONDS=1800
RESET_LINK_TTL_SECONDS=3600
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=5
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_COOLDOWN_SECONDS=60
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Public API origin ChatGPT/Claude should call (https://api.example.com). Optional;
# Profile mcpUrl falls back to the request host when unset.
# MCP_PUBLIC_URL=
# Ticket photo uploads (Cloudinary). Leave blank locally; POST /tickets with a photo returns CLOUDINARY_NOT_CONFIGURED.
# Either set CLOUDINARY_URL or the three vars below. Assets go under CLOUDINARY_FOLDER/tickets/{uuid}.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lundrii
